{
  "name": "vite-plugin-electron-renderer",
  "version": "0.14.7",
  "description": "Support use Node.js API in Electron-Renderer",
  "keywords": [
    "electron",
    "plugin",
    "renderer",
    "vite"
  ],
  "license": "MIT",
  "author": "草鞋没号 <308487730@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electron-vite/vite-plugin-electron-renderer.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cjs-shim": {
      "import": "./dist/cjs-shim.mjs",
      "require": "./dist/cjs-shim.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "oxlint -c .oxlintrc.mjs",
    "format": "oxfmt -c .oxfmtrc.mjs --check .",
    "prepublishOnly": "pnpm build && pnpm test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@subf/config": "^0.2.1",
    "defu": "^6.1.7",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.33.2"
}
