{
  "name": "vite-plugin-electron-renderer",
  "version": "0.14.6",
  "description": "Support use Node.js API in Electron-Renderer",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electron-vite/vite-plugin-electron-renderer.git"
  },
  "author": "草鞋没号 <308487730@qq.com>",
  "license": "MIT",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "prepublishOnly": "npm run build && npm run test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@subf/config": "^0.2.1",
    "electron": "^32.1.2",
    "esbuild": "^0.23.1",
    "lib-esm": "^0.4.2",
    "node-fetch": "^3.3.2",
    "serialport": "^12.0.0",
    "tsdown": "^0.12.0",
    "vite": "^8.0.0",
    "vite-plugin-utils": "^0.4.3",
    "vitest": "^2.1.1"
  },
  "peerDependencies": {
    "vite": ">=8.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vite",
    "plugin",
    "electron",
    "renderer"
  ]
}
